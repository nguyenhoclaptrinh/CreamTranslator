#!/bin/sh
# Git Pre-commit hook for CreamTranslator
# Ensures code formatting standards before committing

# Fast Check: Only run Spotless if Kotlin or Gradle configuration files are staged
STAGED_CODE_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(kt|kts|properties)$' || true)

if [ -z "$STAGED_CODE_FILES" ]; then
    echo "[HOOK] Fast-pass: No Kotlin or Gradle source files staged. Skipping Spotless check."
    exit 0
fi

echo "[HOOK] Source files detected. Running pre-commit code formatting check..."

if command -v java >/dev/null 2>&1 && [ -f "./gradlew" ]; then
    ./gradlew spotlessCheck --daemon --continue
    RESULT=$?
    if [ $RESULT -ne 0 ]; then
        echo "[ERROR] Code formatting check failed! Please run './gradlew spotlessApply' to format automatically."
        exit 1
    fi
else
    echo "[HOOK] Local Java runtime not detected in PATH; formatting check deferred to GitHub Actions CI."
fi

echo "[HOOK] Pre-commit formatting check passed successfully."
exit 0
